# Community League environment contract

# Prisma direct database connection.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# Supabase browser/server client connection.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<local-or-project-publishable-key>"

# Compatibility alias for older internal code. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<same-value-as-publishable-key-if-needed>"

# Server-only secret key is reserved for a later admin/service phase.
# Do not expose this to browser code.
SUPABASE_SECRET_KEY=""

# Reserved for later cache, email, storage, and fraud engine phases.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RESEND_API_KEY=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
GOOGLE_MAPS_API_KEY=""
IPINFO_TOKEN=""